#!/usr/bin/env bash
# Local pre-commit gate: SwiftLint only (fast). Not installed automatically --
# see docs/testing.md "Local git hooks" for the one-time opt-in command.
# Deliberately does not run the full test suite here: xcodebuild test takes
# long enough that a mandatory pre-commit run would just train people to
# --no-verify past it. Use ./test.sh manually, or let CI's macos-tests job
# catch it, before pushing.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v swiftlint >/dev/null 2>&1; then
  echo "pre-commit: swiftlint not installed, skipping (brew install swiftlint)" >&2
  exit 0
fi

echo "pre-commit: running SwiftLint..."
if ! swiftlint lint --strict; then
  echo "pre-commit: SwiftLint failed. Fix the above, or commit with --no-verify to bypass." >&2
  exit 1
fi
